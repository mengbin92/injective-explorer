# ============================================
# Injective Explorer Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# cp .env.example .env

# ============================================
# Server Configuration
# ============================================
# HTTP server port
HTTP_PORT=8000

# gRPC server port
GRPC_PORT=9000

# Enable pprof profiling endpoint (default: false, disable in production)
ENABLE_PPROF=false

# Enable Swagger UI (default: true)
# SERVER_ENABLE_SWAGGER=true

# Enable CORS in code (default: true for dev, false for prod)
# Note: CORS is usually handled by Nginx/Envoy in production
# SERVER_ENABLE_CORS=true

# ============================================
# Database Configuration
# ============================================
# Database username
DB_USER=root

# Database password (change in production)
DB_PASSWORD=jKBrZHGcsNG5fMc52EWz

# Database host address
# For Docker Compose: use service name (e.g., injective-explorer-mysql)
# For local development: localhost or 127.0.0.1
DB_HOST=localhost

# Database port
DB_PORT=3306

# Database name
DB_NAME=explorer

# ============================================
# Redis Configuration
# ============================================
# Redis host address
# For Docker Compose: use service name (e.g., injective-explorer-redis)
# For local development: localhost or 127.0.0.1
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number
REDIS_DB=0

# Redis connection pool size
# REDIS_POOL_SIZE=100

# Redis read timeout (e.g., "0.2s", "500ms")
# REDIS_READ_TIMEOUT=0.2s

# Redis write timeout (e.g., "0.2s", "500ms")
# REDIS_WRITE_TIMEOUT=0.2s

# ============================================
# Object Storage Configuration
# ============================================
# Object storage provider: minio, s3, oss, cos
# Default: minio (for development/testing)
OBJECT_STORAGE_PROVIDER=minio

# Object storage endpoint
# MinIO: localhost:9000
# AWS S3: s3.amazonaws.com or s3.<region>.amazonaws.com
# Alibaba OSS: oss-<region>.aliyuncs.com
# Tencent COS: cos.<region>.myqcloud.com
OBJECT_STORAGE_ENDPOINT=localhost:9000

# Object storage access key ID
OBJECT_STORAGE_ACCESS_KEY=minioadmin

# Object storage secret access key
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Object storage bucket name
OBJECT_STORAGE_BUCKET=injective-explorer

# Object storage region (required for S3/OSS)
OBJECT_STORAGE_REGION=us-east-1

# Use SSL/TLS for object storage connection
# Default: false (for local MinIO), true for cloud providers
OBJECT_STORAGE_USE_SSL=false

# Path prefix for objects in storage (e.g., "transactions/")
OBJECT_STORAGE_PATH_PREFIX=transactions/

# Enable object storage (default: false, set to true to enable)
# When disabled, data will be stored in database only
OBJECT_STORAGE_ENABLED=false

# ============================================
# Logging Configuration
# ============================================
# Log level: debug(-1), info(0), warn(1), error(2), dpanic(3), panic(4), fatal(5)
# Default: 0 (info)
LOG_LEVEL=0

# Log format: json or console
# Default: console (for development), json (for production)
LOG_FORMAT=console

SYNC_BLOCKS_EARLIEST_HEIGHT=1

# ============================================
# Chain Configuration
# ============================================
# Chain network type: mainnet, testnet
CHAIN_NETWORK=injective

# Chain ID
CHAIN_ID=injective-1

# Chain name
CHAIN_NAME=injective

# Fee denominator
CHAIN_FEE_DENOM=inj

# LCD API endpoint
CHAIN_LCD_ENDPOINT=http://165.154.5.191:10437

# Tendermint RPC endpoint
CHAIN_TM_ENDPOINT=http://165.154.5.191:26757

# Chain gRPC endpoint
CHAIN_GRPC_ENDPOINT=sentry.chain.grpc.injective.network:443

# Chain streaming gRPC endpoint
CHAIN_STREAM_GRPC_ENDPOINT=sentry.chain.stream.injective.network:443

# Exchange gRPC endpoint
CHAIN_EXCHANGE_GRPC_ENDPOINT=sentry.exchange.grpc.injective.network:443

# Explorer gRPC endpoint
CHAIN_EXPLORER_GRPC_ENDPOINT=sentry.explorer.grpc.injective.network:443

# Official tokens list URL
CHAIN_OFFICIAL_TOKENS_LIST_URL=https://github.com/InjectiveLabs/injective-lists/raw/master/json/tokens/testnet.json

# EVM RPC endpoint
CHAIN_EVM_RPC_ENDPOINT=https://sentry.evm-rpc.injective.network

# EVM WebSocket endpoint
CHAIN_EVM_WS_ENDPOINT=wss://sentry.evm-ws.injective.network

# EVM chain ID
CHAIN_EVM_CHAIN_ID=801

# ============================================
# Development Environment Setup
# ============================================
# Quick start for development:
# 1. Start infrastructure: make dev-up
# 2. Run application: make run (or: kratos run -c ./configs)
#
# Available make commands:
#   make dev-up     - Start MySQL, Redis, MinIO, Envoy in Docker
#   make dev-down   - Stop infrastructure services
#   make dev-logs   - View infrastructure logs
#   make dev-clean  - Stop and remove all data (WARNING: deletes volumes)
#   make run        - Start infrastructure (if not running) and run app with kratos
#   make run-go     - Start infrastructure (if not running) and run app with go run
#
# Infrastructure ports (when using docker-compose.dev.yaml):
#   MySQL:    localhost:3306
#   Redis:    localhost:6379
#   MinIO:    localhost:19000 (API), localhost:19001 (Console)
#   Envoy:    localhost:9001 (grpc-web), localhost:9901 (admin)
#
# Note: When using Docker Desktop on macOS/Windows, host.docker.internal
# automatically resolves to the host. For Linux, you may need to add:
#   extra_hosts:
#     - "host.docker.internal:host-gateway"
# to docker-compose.dev.yaml services.

# ============================================
# Notes
# ============================================
# 1. Environment variables take precedence over config.yaml values
# 2. For production, change all default passwords and secrets
# 3. Object storage is disabled by default. Enable it by setting OBJECT_STORAGE_ENABLED=true
# 4. For MinIO (local development):
#    - Run: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
#    - Access console: http://localhost:9001 (minioadmin/minioadmin)
# 5. For AWS S3:
#    - Set OBJECT_STORAGE_PROVIDER=s3
#    - Set OBJECT_STORAGE_ENDPOINT=s3.amazonaws.com (or regional endpoint)
#    - Set OBJECT_STORAGE_REGION to your AWS region
#    - Set OBJECT_STORAGE_USE_SSL=true
#    - Use AWS IAM credentials for OBJECT_STORAGE_ACCESS_KEY and OBJECT_STORAGE_SECRET_KEY
# 6. For Alibaba OSS:
#    - Set OBJECT_STORAGE_PROVIDER=oss
#    - Set OBJECT_STORAGE_ENDPOINT=oss-<region>.aliyuncs.com
#    - Set OBJECT_STORAGE_REGION to your OSS region
#    - Set OBJECT_STORAGE_USE_SSL=true
#    - Use OSS AccessKey ID and AccessKey Secret
