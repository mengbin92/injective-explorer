# =============================================================================
# Injective Explorer Environment Variables Configuration
# =============================================================================
# 
# This file contains example environment variables for the injective-explorer application.
# Copy this file to .env and modify the values according to your environment.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env with your actual configuration values
#   3. The application will load these variables automatically
#
# Note: Kratos config system supports environment variable override using dot-notation:
#   - SERVER_HTTP_ADDR overrides server.http.addr
#   - DATA_DATABASE_SOURCE overrides data.database.source
#   - DATA_REDIS_ADDR overrides data.redis.addr
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application Debugging
# -----------------------------------------------------------------------------
# Enable pprof profiling endpoint (for development/staging only)
# Set to "true" to enable pprof on localhost:6060
# WARNING: Should be disabled in production for security reasons
ENABLE_PPROF=false

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# HTTP server port
# Default: 8000
# Format: <port_number>
HTTP_PORT=8000

# gRPC server port
# Default: 9000
# Format: <port_number>
GRPC_PORT=9000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Database username
# Default: root
DB_USER=root

# Database password
# Default: (empty, set your password)
# WARNING: Change this in production!
DB_PASSWORD=jKBrZHGcsNG5fMc52EWz

# Database host address
# Default: localhost
# For Docker Compose: use service name (e.g., injective-explorer-mysql)
# For local development: localhost or 127.0.0.1
DB_HOST=localhost

# Database port
# Default: 3306 (MySQL default port)
DB_PORT=3306

# Database name
# Default: explorer
DB_NAME=explorer

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis host address
# Default: localhost
# For Docker Compose: use service name (e.g., injective-explorer-redis)
# For local development: localhost or 127.0.0.1
REDIS_HOST=localhost

# Redis port
# Default: 6379 (Redis default port)
REDIS_PORT=6379

# Redis password
# Default: (empty, no password)
# Set this if your Redis instance requires authentication
REDIS_PASSWORD=

# Redis database number
# Default: 0
# Redis supports multiple databases (0-15 by default)
REDIS_DB=0

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# 
# The following environment variables can be used to override specific config
# values using Kratos dot-notation. These are optional and will override
# corresponding values in config.yaml.
#
# Examples:
#   SERVER_HTTP_ADDR=0.0.0.0:8080
#   SERVER_GRPC_ADDR=0.0.0.0:9090
#   DATA_DATABASE_SOURCE=user:pass@tcp(host:port)/dbname
#   DATA_REDIS_ADDR=localhost:6380
#   LOG_LEVEL=0
#   LOG_FORMAT=json
#
# =============================================================================
