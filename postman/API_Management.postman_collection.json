{
	"info": {
		"_postman_id": "api-management-collection",
		"name": "Injective Explorer - API Management",
		"description": "API Management collection for token management and API access",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Token Management",
			"item": [
				{
					"name": "Create Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has standard format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('code');",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.code).to.equal(200);",
									"});",
									"",
									"pm.test(\"Response data has token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    pm.expect(jsonData.data).to.have.property('token_preview');",
									"    pm.expect(jsonData.data).to.have.property('token_id');",
									"    ",
									"    // Save token for later use",
									"    pm.environment.set(\"api_token\", jsonData.data.token);",
									"    pm.environment.set(\"token_id\", jsonData.data.token_id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-User-ID",
								"value": "{{user_id}}",
								"description": "User ID from external auth system"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"My API Token\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/tokens",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"tokens"
							]
						},
						"description": "Create a new API token. The full token is only shown once in the response."
					},
					"response": []
				},
				{
					"name": "List Tokens",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has standard format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('code');",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.code).to.equal(200);",
									"});",
									"",
									"pm.test(\"Response data has tokens array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('tokens');",
									"    pm.expect(jsonData.data.tokens).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-ID",
								"value": "{{user_id}}",
								"description": "User ID from external auth system"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/tokens",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"tokens"
							]
						},
						"description": "List all API tokens for the authenticated user."
					},
					"response": []
				},
				{
					"name": "Get Token Usage",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has standard format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('code');",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.code).to.equal(200);",
									"});",
									"",
									"pm.test(\"Response data has usage statistics\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('total_calls');",
									"    pm.expect(jsonData.data).to.have.property('success_calls');",
									"    pm.expect(jsonData.data).to.have.property('failed_calls');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-ID",
								"value": "{{user_id}}",
								"description": "User ID from external auth system"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/tokens/usage?token_id={{token_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"tokens",
								"usage"
							]
						},
						"description": "Get usage statistics for a specific token."
					},
					"response": []
				},
				{
					"name": "Delete Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has standard format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('code');",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.code).to.equal(200);",
									"});",
									"",
									"pm.test(\"Response data has success message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('message');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-User-ID",
								"value": "{{user_id}}",
								"description": "User ID from external auth system"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/tokens?token_id={{token_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"tokens"
							],
							"query": [
								{
									"key": "token_id",
									"value": "{{token_id}}",
									"description": "Token ID to delete"
								}
							]
						},
						"description": "Delete an API token. Only tokens owned by the authenticated user can be deleted."
					},
					"response": []
				}
			],
			"description": "Token management endpoints require X-User-ID header for authentication."
		},
		{
			"name": "API Access (with Token)",
			"item": [
				{
					"name": "Get Latest Blocks",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 500ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(500);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}",
								"description": "API token for authentication"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/block/latest?page=1&page_size=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"block",
								"latest"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "10"
								}
							]
						},
						"description": "Get latest blocks. Requires Bearer token authentication."
					},
					"response": []
				},
				{
					"name": "Get Transaction By Hash",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
