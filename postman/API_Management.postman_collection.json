								"description": "API token for authentication"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/transaction/by-hash?hash={{tx_hash}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"transaction",
								"by-hash"
							],
							"query": [
								{
									"key": "hash",
									"value": "{{tx_hash}}",
									"description": "Transaction hash"
								}
							]
						},
						"description": "Get transaction by hash. Requires Bearer token authentication."
					},
					"response": []
				},
				{
					"name": "Get Account Info",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}",
								"description": "API token for authentication"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/account/info?address={{account_address}}",
