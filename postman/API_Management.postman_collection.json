			],
			"description": "API endpoints that require Bearer token authentication. Rate limiting applies: IP (100/min), Token (5/sec), User (100k/month)."
		},
		{
			"name": "Rate Limit Tests",
			"item": [
				{
					"name": "Test IP Rate Limit",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 429) {",
									"    pm.test(\"Rate limit exceeded\", function () {",
									"        pm.expect(pm.response.json().message).to.include('rate limit');",
									"    });",
									"} else {",
									"    pm.test(\"Request allowed\", function () {",
									"        pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/block/latest-height",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"block",
								"latest-height"
							]
						},
						"description": "Test IP rate limit (100 requests per minute). Run this request multiple times quickly to trigger rate limit."
					},
					"response": []
				},
				{
					"name": "Test Token Rate Limit",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 429) {",
									"    pm.test(\"Token rate limit exceeded\", function () {",
									"        var jsonData = pm.response.json();",
									"        pm.expect(jsonData.message || jsonData.error).to.include('rate limit');",
									"    });",
									"} else {",
									"    pm.test(\"Request allowed\", function () {",
									"        pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/block/latest-height",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"block",
								"latest-height"
							]
						},
						"description": "Test token rate limit (5 requests per second). Run this request 6+ times per second to trigger rate limit."
					},
					"response": []
				},
				{
					"name": "Test Invalid Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Error message indicates invalid token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message || jsonData.error).to.include('token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer invalid_token_12345"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/block/latest-height",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"block",
								"latest-height"
							]
						},
						"description": "Test authentication with invalid token. Should return 401 Unauthorized."
					},
					"response": []
				},
				{
					"name": "Test Missing Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Error message indicates missing Authorization header\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message || jsonData.error).to.include('Authorization');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/block/latest-height",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"block",
								"latest-height"
							]
						},
						"description": "Test API access without token. Should return 401 Unauthorized."
					},
					"response": []
				}
			],
			"description": "Tests for rate limiting and authentication scenarios."
		}
